{
  "name": "@asqav/pi",
  "version": "0.1.0",
  "description": "Asqav extension for the pi coding agent - sign and gate tool calls before they execute",
  "keywords": [
    "pi-package",
    "asqav",
    "pi",
    "coding-agent",
    "ai-governance",
    "tool-calling",
    "audit-trail"
  ],
  "license": "Elastic-2.0",
  "author": "Asqav <info@asqav.com>",
  "homepage": "https://asqav.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagmarques/asqav-pi.git"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "docs",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:coverage": "vitest run --coverage.enabled --coverage.include=extensions/asqav.ts --coverage.reporter=json --coverage.reporter=text"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@asqav/sdk": "^0.10.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.9",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@vitest/coverage-v8": "4.1.9",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
